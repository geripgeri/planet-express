# Managed by Ansible (ansible/roles/garage). Do not edit by hand.
# See https://garagehq.deuxfleurs.fr/documentation/reference-manual/configuration/

metadata_dir = "{{ garage_meta_dir }}"
data_dir = "{{ garage_data_dir }}"
db_engine = "lmdb"
metadata_auto_snapshot_interval = "{{ garage_metadata_snapshot_interval }}"

# Single-node cluster (replication factor 1): no intra-cluster redundancy.
# Data protection relies on the rclone snapshot strategy documented in
# ADR-015, not on Garage replicas.
replication_factor = 1

rpc_secret = "{{ garage_rpc_secret }}"
rpc_bind_addr = "{{ garage_rpc_bind_addr }}"

[s3_api]
api_bind_addr = "{{ garage_s3_bind_addr }}"
s3_region = "{{ garage_s3_region }}"

[admin]
api_bind_addr = "{{ garage_admin_bind_addr }}"
admin_token = "{{ garage_admin_token }}"
metrics_token = "{{ garage_metrics_token }}"
