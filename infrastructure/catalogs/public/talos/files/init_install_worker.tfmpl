# CNI is Cilium, managed through ArgoCD. Talos deploys Flannel by default;
# deleting the document is the multi-doc equivalent of the old
# `cluster.network.cni.name: none`.
apiVersion: v1alpha1
kind: KubeFlannelCNIConfig
$patch: delete
---
# Cilium replaces kube-proxy. Deleting the document is the multi-doc
# equivalent of the old `cluster.proxy.disabled: true`.
apiVersion: v1alpha1
kind: KubeProxyConfig
$patch: delete
