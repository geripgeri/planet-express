apiVersion: v1alpha1
kind: ResolverConfig
nameservers:
%{ for ns in vlan10_nameservers ~}
  - address: ${ns}
%{ endfor ~}
---
apiVersion: v1alpha1
kind: LinkConfig
name: ens18
up: true
routes:
  # No destination: Talos creates the default route for the address family
  # of the gateway. Setting `0.0.0.0/0` explicitly is rejected by the node
  # with "route 0 destination must be a valid IP prefix".
  - gateway: ${vlan10_gateway}
    metric: 100
---
apiVersion: v1alpha1
kind: DHCPv4Config
name: ens18
routeMetric: 100
---
apiVersion: v1alpha1
kind: LinkConfig
name: ens19
up: true
addresses:
  - address: ${vlan20_ip}